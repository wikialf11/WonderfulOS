#!/bin/sh
# Configuración de live-build para la ISO de WonderfulOS (Debian 13 + KDE Plasma).
set -e

lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --linux-flavours amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --binary-images iso-hybrid \
  --bootloaders "grub-pc,grub-efi" \
  --debian-installer none \
  --firmware-binary true \
  --firmware-chroot true \
  --iso-application "WonderfulOS" \
  --iso-publisher "WonderfulOS" \
  --iso-volume "WonderfulOS" \
  --image-name "nubeos" \
  --memtest none \
  --apt-recommends false \
  --bootappend-live "boot=live components quiet splash locales=es_ES.UTF-8 keyboard-layouts=es timezone=Europe/Madrid username=nubeos hostname=nubeos" \
  "${@}"
